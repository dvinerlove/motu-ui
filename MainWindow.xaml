<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MotuUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
>
    <Grid Padding="20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <TextBlock x:Name="StatusText"
                       FontFamily="Segoe UI Variable Display" FontSize="28" FontWeight="SemiBold"
                       CharacterSpacing="-20"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="BtnTest" Padding="10" MinWidth="36" MinHeight="32"
                        Background="Transparent" BorderThickness="0"
                        ToolTipService.ToolTip="play a test tone through the device — watch OUT and LOOP light up">
                    <FontIcon Glyph="&#xE767;" FontSize="13"/>
                </Button>
                <Button x:Name="BtnUpdate" Padding="10" MinWidth="36" MinHeight="32"
                        Background="Transparent" BorderThickness="0"
                        ToolTipService.ToolTip="check for driver update on motu.com">
                    <FontIcon Glyph="&#xE896;" FontSize="13"/>
                </Button>
                <Button x:Name="BtnRefresh" Padding="10" MinWidth="36" MinHeight="32"
                        Background="Transparent" BorderThickness="0"
                        ToolTipService.ToolTip="Re-read device state">
                    <FontIcon Glyph="&#xE72C;" FontSize="13"/>
                </Button>
            </StackPanel>
        </Grid>
        <TextBlock x:Name="InfoText" Grid.Row="1"
                   FontFamily="Cascadia Mono, Consolas" FontSize="11"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

        <Border Grid.Row="2" Padding="16,12" CornerRadius="10"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="16"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="IN" Grid.Row="0" VerticalAlignment="Center"
                           Style="{ThemeResource CaptionTextBlockStyle}" CharacterSpacing="60"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <Grid x:Name="MeterInHost" Grid.Row="0" Grid.Column="1" Margin="12,0" MinHeight="28"
                      ToolTipService.ToolTip="click to reset clip"/>
                <TextBlock x:Name="DbIn" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center"
                           FontFamily="Cascadia Mono, Consolas" FontSize="12" Width="72" Text="-&#x221E;"
                           TextAlignment="Right"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                <TextBlock Text="OUT" Grid.Row="1" VerticalAlignment="Center"
                           Style="{ThemeResource CaptionTextBlockStyle}" CharacterSpacing="60"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <Grid x:Name="MeterOutHost" Grid.Row="1" Grid.Column="1" Margin="12,0" MinHeight="28"
                      ToolTipService.ToolTip="click to reset clip"/>
                <TextBlock x:Name="DbOut" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center"
                           FontFamily="Cascadia Mono, Consolas" FontSize="12" Width="72" Text="-&#x221E;"
                           TextAlignment="Right"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                <TextBlock Text="LOOP" Grid.Row="2" VerticalAlignment="Center"
                           Style="{ThemeResource CaptionTextBlockStyle}" CharacterSpacing="60"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <Grid x:Name="MeterLoopHost" Grid.Row="2" Grid.Column="1" Margin="12,0" MinHeight="28"
                      ToolTipService.ToolTip="loopback — playback audio as recorders hear it (what OBS captures); click to reset clip"/>
                <TextBlock x:Name="DbLoop" Grid.Row="2" Grid.Column="2" VerticalAlignment="Center"
                           FontFamily="Cascadia Mono, Consolas" FontSize="12" Width="72" Text="-&#x221E;"
                           TextAlignment="Right"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                <Grid x:Name="ScaleHost" Grid.Row="3" Grid.Column="1" Margin="12,0"/>
            </Grid>
        </Border>

        <Border Grid.Row="3" Padding="16,12" CornerRadius="10"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="6">
                    <TextBlock Text="SAMPLE RATE" Style="{ThemeResource CaptionTextBlockStyle}" CharacterSpacing="60"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <ComboBox x:Name="RateBox" HorizontalAlignment="Stretch" Height="36"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="6">
                    <TextBlock Text="BUFFER" Style="{ThemeResource CaptionTextBlockStyle}" CharacterSpacing="60"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <ComboBox x:Name="BufBox" HorizontalAlignment="Stretch" Height="36"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="6">
                    <TextBlock Text="WAVESRC" Style="{ThemeResource CaptionTextBlockStyle}" CharacterSpacing="60"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <Button x:Name="SrcSwitch" HorizontalAlignment="Stretch" Height="36"
                            Padding="12,0" HorizontalContentAlignment="Left"
                            ToolTipService.ToolTip="driver resamples Windows audio to the device rate — on: apps at any rate work, off: bit-exact when everything matches">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse x:Name="SrcDot" Width="8" Height="8" VerticalAlignment="Center"
                                     Fill="{ThemeResource TextFillColorTertiaryBrush}"/>
                            <TextBlock x:Name="SrcState" Text="Off"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Grid.Column="3" Spacing="6">
                    <TextBlock Text="LOW LATENCY" Style="{ThemeResource CaptionTextBlockStyle}" CharacterSpacing="60"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <Button x:Name="LlSwitch" HorizontalAlignment="Stretch" Height="36"
                            Padding="12,0" HorizontalContentAlignment="Left"
                            ToolTipService.ToolTip="cuts extra driver buffering — for live monitoring/recording; keep off for stable playback (device can't report this state back)">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse x:Name="LlDot" Width="8" Height="8" VerticalAlignment="Center"
                                     Fill="{ThemeResource TextFillColorTertiaryBrush}"/>
                            <TextBlock x:Name="LlState" Text="Off"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="4" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="BtnRec" Grid.Column="0" HorizontalAlignment="Stretch" Height="36"
                    ToolTipService.ToolTip="apply preset"/>
            <Button x:Name="BtnEditRec" Grid.Column="1" Width="44" Height="36"
                    ToolTipService.ToolTip="edit this preset">
                <FontIcon Glyph="&#xE70F;" FontSize="13"/>
            </Button>
            <Button x:Name="BtnStream" Grid.Column="2" HorizontalAlignment="Stretch" Height="36"
                    ToolTipService.ToolTip="apply preset"/>
            <Button x:Name="BtnEditStream" Grid.Column="3" Width="44" Height="36"
                    ToolTipService.ToolTip="edit this preset">
                <FontIcon Glyph="&#xE70F;" FontSize="13"/>
            </Button>
        </Grid>
    </Grid>
</Window>
